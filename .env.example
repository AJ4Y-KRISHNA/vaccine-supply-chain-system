# Copy to .env for the local-only synthetic demonstration. Replace every placeholder.
MAX_SPEED_KMH=120
JWT_SECRET=replace-with-at-least-32-random-characters
REFRESH_SECRET=replace-with-a-different-32-character-secret
TEMP_API_KEY=replace-with-a-separate-32-character-api-key
EDGE_GATEWAY_API_KEY=replace-with-a-different-32-character-gateway-key
EDGE_GATEWAY_DEVICE_SECRET=replace-with-a-separate-random-32-character-device-secret
SIMULATOR_SCENARIO=NORMAL
SIMULATOR_SEED=1
DATA_MODE=mixed
EDGE_GATEWAY_HEARTBEAT_MS=30000
EDGE_GATEWAY_FLUSH_INTERVAL_MS=3000
EDGE_MIN_TEMPERATURE=2
EDGE_MAX_TEMPERATURE=8
MQTT_USERNAME=synthetic-demo
MQTT_PASSWORD=replace-with-a-long-mqtt-password
REDIS_PASSWORD=replace-with-a-long-redis-password
DEMO_SEED_PASSWORD=replace-with-a-strong-local-demo-password

# These roles are reachable only on this machine; container-to-container traffic
# remains on the private Compose network.
MONGO_HOST_PORT=27017
MQTT_HOST_PORT=1883
REDIS_HOST_PORT=6379
HARDHAT_HOST_PORT=8545
AI_HOST_PORT=8000
BACKEND_HOST_PORT=5000
FRONTEND_HOST_PORT=3000
FIELD_PANEL_HOST_PORT=5173
MERKLE_WINDOW_SECONDS=30
# Optional Phase 5 companion; keep empty on a fresh chain, set after upgrade deployment.
MERKLE_CONTRACT_ADDRESS=
