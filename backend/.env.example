MONGO_URI=mongodb://127.0.0.1:27017/vaccineDB
JWT_SECRET=replace-with-at-least-32-random-characters
REFRESH_SECRET=replace-with-different-random-characters
TEMP_API_KEY=replace-with-at-least-32-random-characters
EDGE_GATEWAY_DEVICE_SECRET=replace-with-a-separate-random-32-character-device-secret
HOST=127.0.0.1
PORT=5000
# Virtual sensor readings use this HTTP ingestion endpoint; default is the
# local backend URL above. MQTT is the preferred transport; HTTP is the fallback.
# Start the loopback-only broker with `docker compose -f docker-compose.mqtt.yml up -d`.
SIMULATOR_TRANSPORT=mqtt
DATA_MODE=mixed
SIMULATOR_HTTP_FALLBACK=true
# Optional separate Edge Gateway. If enabled, point SIMULATOR_INGEST_URL at
# http://127.0.0.1:5100/ingest and configure SIMULATOR_INGEST_API_KEY there.
# SIMULATOR_INGEST_URL=http://127.0.0.1:5100/ingest
# SIMULATOR_INGEST_API_KEY=replace-with-a-separate-local-gateway-key
# Set false when the separate gateway owns MQTT telemetry consumption, to
# avoid the legacy backend subscriber processing the same broker topic.
MQTT_TELEMETRY_SUBSCRIBER_ENABLED=true
MQTT_URL=mqtt://127.0.0.1:1883
SIMULATOR_SCENARIO=NORMAL
SIMULATOR_SEED=1
MQTT_TOPIC_PREFIX=vaccine/telemetry
# Optional broker authentication. Never put credentials in MQTT_URL.
# MQTT_USERNAME=
# MQTT_PASSWORD=
# SIMULATOR_INGEST_URL=http://127.0.0.1:5000/api/temperature/ingest
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Browser origins allowed to open the standalone Field Operator WebSocket.
# The two local Vite origins are allowed by default; set this to an explicit
# comma-separated allowlist when running the panel from another origin.
# FIELD_OPERATOR_WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Release a connection-owned manual override after this many simulated minutes.
FIELD_OPERATOR_DISCONNECT_GRACE_MINUTES=2
RPC_URL=http://127.0.0.1:8545
# Compile/deploy the current contract locally before enabling these settings.
CONTRACT_ADDRESS=
LOCAL_CHAIN_DEMO=false
AUDIT_ANCHOR_ENABLED=true
# Admin-only manual sensor overrides; keep off unless running a synthetic local demo.
SIMULATOR_MANUAL_OVERRIDES_ENABLED=false
# Optional simulated-time expiry settings (default 30 minutes, hard cap 24 hours).
# SIMULATOR_OVERRIDE_DEFAULT_TTL_MS=1800000
# SIMULATOR_OVERRIDE_MAX_TTL_MS=86400000
# If LOCAL_CHAIN_DEMO=true, explicit public Hardhat test accounts are used.
# Otherwise set separate PRIVATE_KEY, PRODUCTION_PRIVATE_KEY, LAB_PRIVATE_KEY.
AI_BASE_URL=http://127.0.0.1:8000
# Local thesis JSON exports (synthetic analytics only); default backend/data/analytics.
# ANALYTICS_METRICS_DIR=./data/analytics
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Opt-in asynchronous telemetry path. Requires MongoDB replica set (rs0 in Compose).
EVENT_BACKBONE_ENABLED=false
EVENT_STREAM_PREFIX=vaccine:synthetic
EVENT_MAX_ATTEMPTS=20
TELEMETRY_RETENTION_SECONDS=7776000
# Optional local readiness probe; leave unset when Redis is not running.
# REDIS_PASSWORD=
# Advisory telemetry anomaly inference fails open to the existing rules at this timeout.
AI_ANOMALY_TIMEOUT_MS=750
# Optional alert email delivery. Disabled unless deliberately enabled.
# Ethereal uses real SMTP to a disposable capture mailbox; it does not deliver to recipients.
# SendGrid requires a verified sender and a valid API key.
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TRANSPORT=console
# Set ALERT_EMAIL_TRANSPORT=ethereal to test SMTP delivery and retain its preview URL.
# ALERT_EMAIL_APP_URL=http://localhost:3000
# ALERT_EMAIL_FROM=verified-sender@example.test
# SENDGRID_API_KEY=
# ALERT_EMAIL_MAX_ATTEMPTS=5
# ALERT_EMAIL_RETRY_BASE_MS=30000
# Optional companion address preserves the original batch/lifecycle contract.
MERKLE_CONTRACT_ADDRESS=
TELEMETRY_ANCHOR_MODE=merkle
MERKLE_WINDOW_SECONDS=300
