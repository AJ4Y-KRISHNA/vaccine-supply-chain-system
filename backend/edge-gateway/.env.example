# Dedicated local Edge Gateway process for synthetic telemetry.
EDGE_GATEWAY_HOST=127.0.0.1
EDGE_GATEWAY_PORT=5100
MONGO_URI=mongodb://127.0.0.1:27017/vaccine_supply_chain
EDGE_GATEWAY_API_KEY=replace-with-a-random-local-gateway-key
EDGE_GATEWAY_DEVICE_SECRET=replace-with-a-separate-local-device-secret
EDGE_GATEWAY_UPSTREAM_URL=http://127.0.0.1:5000/api/temperature/ingest
# Set this to the backend TEMP_API_KEY. Do not commit actual credentials.
EDGE_GATEWAY_UPSTREAM_API_KEY=replace-with-the-backend-temperature-api-key
EDGE_GATEWAY_MQTT_ENABLED=true
EDGE_GATEWAY_HEARTBEAT_MS=30000
EDGE_GATEWAY_FLUSH_INTERVAL_MS=3000
EDGE_MIN_TEMPERATURE=2
EDGE_MAX_TEMPERATURE=8
MAX_SPEED_KMH=120
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_TOPIC_PREFIX=vaccine/telemetry
# Optional broker credentials. Keep them in this local .env only.
# MQTT_USERNAME=
# MQTT_PASSWORD=
